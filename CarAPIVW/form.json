{
  "elements": [
    {"type": "CheckBox", "name": "TestEnabled", "caption": "VW-Test aktivieren"},
    {"type": "ValidationTextBox", "name": "VehicleVIN", "caption": "Fahrgestellnummer (FIN)"}
  ],
  "actions": [
    {"type": "ValidationTextBox", "name": "LoginEmail", "caption": "E-Mail der Volkswagen ID"},
    {"type": "PasswordTextBox", "name": "LoginSecret", "caption": "VW-Passwort"},
    {"type": "Button", "caption": "Bei VW anmelden", "onClick": "echo SCAV_Login($id, $LoginEmail, $LoginSecret);"},
    {"type": "PasswordTextBox", "name": "EmailCode", "caption": "VW-E-Mail-Code"},
    {"type": "Button", "caption": "Code bestätigen", "onClick": "echo SCAV_ConfirmLogin($id, $EmailCode);"},
    {"type": "Button", "caption": "Ladedaten abrufen", "onClick": "echo SCAV_ReadCharging($id);"},
    {"type": "Button", "caption": "Lokale Sitzung löschen", "onClick": "echo SCAV_ClearSession($id);"}
  ]
}
